generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  passwordHash  String
  displayName   String
  role          String    @default("teacher") // admin | supervisor | teacher
  allowedTracks String    @default("[]")
  allowedGrades String    @default("[]")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  markedRecords AttendanceRecord[] @relation("MarkedBy")
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  track     String   @default("visual") // visual | performing | music — كل مادة لها طلابها
  gradeId   String // grade4 | grade5 | grade_int1 | grade_int2
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  attendance AttendanceRecord[]
}

model AttendanceRecord {
  id         Int      @id @default(autoincrement())
  date       String // YYYY-MM-DD
  track      String // visual | performing | music
  gradeId    String
  studentId  Int
  status     String   @default("present") // present | absent | late | excused
  note       String?
  markedById Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy   User?    @relation("MarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([date, track, gradeId, studentId])
  @@index([date, track, gradeId])
  @@index([studentId])
}
